@model Matemaatika_Funktsioonid.Models.FunktsiooniUurimine
@{
    ViewData["Title"] = "Muuda";
}

<h1>Muuda funktsiooni</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <div class="form-group mb-3">
        <label asp-for="Valem">Valem</label>
        <input asp-for="Valem" class="form-control" />
        <span asp-validation-for="Valem" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Salvesta</button>
    <a asp-action="Index" class="btn btn-secondary">Tagasi</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}